{
  "name": "calendar-app",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://www.calgod.com",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@visx/scale": "^4.0.0",
    "@visx/text": "^4.0.0",
    "@visx/wordcloud": "^4.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "vite": "^8.3.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:concert-api": "wrangler dev -c workers/concert-calender-api/wrangler.jsonc",
    "dev:lastfm-api": "wrangler dev -c workers/lastfm-api/wrangler.jsonc",
    "deploy:concert-api": "wrangler deploy -c workers/concert-calender-api/wrangler.jsonc",
    "deploy:lastfm-api": "wrangler deploy -c workers/lastfm-api/wrangler.jsonc",
    "deploy:workers": "npm run deploy:concert-api && npm run deploy:lastfm-api",
    "cf-typegen": "wrangler types -c workers/concert-calender-api/wrangler.jsonc --env-interface ConcertCalendarEnv --include-runtime false workers/concert-calender-api/worker-configuration.d.ts && wrangler types -c workers/lastfm-api/wrangler.jsonc --env-interface LastFmEnv --include-runtime false workers/lastfm-api/worker-configuration.d.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.104.1",
    "prettier": "3.9.10",
    "wrangler": "^4.169.0"
  }
}
